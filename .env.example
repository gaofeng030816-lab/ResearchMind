# Dots Studio OpenAI-compatible endpoint. Never commit a real API key.
LLM_BASE_URL=https://note3-prev-api.askdiandian.com/v1
LLM_API_KEY=your-dots-api-key-here
LLM_API_KEY_HEADER=api-key
LLM_MODEL=dots3-note-prev

# Translation
TRANSLATION_TARGET_LANGUAGE=zh-CN

# Obsidian
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SUBDIRECTORY=ResearchMind

# Context budgets
CONTEXT_TOKEN_BUDGET=6000
HISTORY_TOKEN_BUDGET=3000

# PDF safety limit
PDF_MAX_SIZE_MB=50
