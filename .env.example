# OpenAI-compatible LLM endpoint. Change this for DeepSeek, Qwen, Kimi, or Ollama.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
# Use api-key for Dots Studio; keep Authorization for standard OpenAI endpoints.
LLM_API_KEY_HEADER=Authorization
LLM_MODEL=your-model-name

# Translation
TRANSLATION_TARGET_LANGUAGE=zh-CN

# Obsidian
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SUBDIRECTORY=ResearchMind

# Context budgets
CONTEXT_TOKEN_BUDGET=6000
HISTORY_TOKEN_BUDGET=3000

# PDF safety limit
PDF_MAX_SIZE_MB=50
